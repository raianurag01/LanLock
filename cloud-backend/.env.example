# Application
NODE_ENV=development
PORT=3000

# WebSocket CORS allowlist — comma-separated origins.
# Dev fallback (when unset): http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Database (individual vars for docker-compose)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=lanlock

# Prisma DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lanlock?schema=public"

# Auth — REQUIRED. App refuses to boot without JWT_SECRET.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
