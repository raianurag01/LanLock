// Prisma Schema for LanLock Cloud Backend
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User - Represents an authenticated account (gamer or admin)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  username     String   @unique
  walletBalance Int     @default(0) @map("wallet_balance")
  role         UserRole @default(GAMER)
  // An ADMIN's home café — scopes what they see in the admin dashboard
  // (venues, stations, orders). Always null for GAMERs.
  venueId      String?  @map("venue_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  sessions Session[]
  devices  UserDevice[]

  @@map("users")
}

// UserDevice - Links a paired PC "Lock" (by its pcId) to an owning User.
model UserDevice {
  id        String   @id @default(uuid())
  pcId      String   @unique @map("pc_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_devices")
}

// Venue - Represents a gaming venue/cafe
model Venue {
  id          String   @id @default(uuid())
  name        String
  location    String
  // LanCoins loyalty program is opt-in per venue (LURK has it; other cafés
  // don't) — gates the mobile wallet's coins chip and the Map's coins row.
  coinRewards Boolean  @default(false) @map("coin_rewards")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  pcNodes PCNode[]

  @@map("venues")
}

// PCNode - Represents a gaming PC at a venue
model PCNode {
  id        String   @id @default(uuid())
  name      String
  specs     String?
  status    PCStatus @default(OFFLINE)
  venueId   String   @map("venue_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("pc_nodes")
}

// Session - Represents a gaming session. Either venue-side (pcNodeId, from
// venues.reservePc against a seeded station) or device-side (pcId, from a
// QR pairing at auth.linkPc) — same duality EventLog/Order already use to
// let free-text device identifiers coexist with the relational venue model.
model Session {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  pcNodeId      String?       @map("pc_node_id")
  pcId          String?       @map("pc_id")
  venueId       String?       @map("venue_id")
  startTime     DateTime      @default(now()) @map("start_time")
  endTime       DateTime?     @map("end_time")
  status        SessionStatus @default(ACTIVE)
  // ₹ debited from walletBalance when a device session is closed at lock.
  amountCharged Int?          @map("amount_charged")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pcNode PCNode? @relation(fields: [pcNodeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([pcId, status])
  @@map("sessions")
}

// EventLog - Append-only audit trail of device lifecycle events. Deliberately
// unrelated to UserDevice: pairings are deleted on lock (unlinkPc), but the
// audit history for a pcId must survive them.
model EventLog {
  id        String          @id @default(uuid())
  pcId      String          @map("pc_id")
  type      DeviceEventType
  detail    String?
  ipAddress String?         @map("ip_address")
  // Reserved for when the lock flow is wired to the Session model; today the
  // pcId is the de-facto session key, so this stays null.
  sessionId String?         @map("session_id")
  createdAt DateTime        @default(now())

  @@index([pcId, createdAt(sort: Desc)])
  @@map("event_logs")
}

// Order - F&B ordered from a gaming seat. Standalone like EventLog: keyed by
// the free-text pcId of the ordering agent so history survives unpairing.
model Order {
  id        String      @id @default(uuid())
  pcId      String      @map("pc_id")
  // Nullable: legacy orders (placed before this column existed) and any
  // future kiosk/walk-in order have no owning user. Plain string, no FK —
  // same "standalone" convention as EventLog/pcId above.
  userId    String?     @map("user_id")
  // Café this order belongs to — scopes the admin Kitchen Display to the
  // admin's own venue. Nullable for the same legacy/unattributed reasons.
  venueId   String?     @map("venue_id")
  item      String
  qty       Int         @default(1)
  amount    Int // ₹ total for the line
  status    OrderStatus @default(PLACED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([venueId, createdAt(sort: Desc)])
  @@map("orders")
}

// Enums
enum UserRole {
  GAMER
  ADMIN
}

enum PCStatus {
  ONLINE
  OFFLINE
  IN_USE
  MAINTENANCE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DeviceEventType {
  PAIRED
  CONNECTED
  DISCONNECTED
  LOCKED
  UNLOCKED
  AUTH_REJECTED
  FAILED_SCAN
}

enum OrderStatus {
  PLACED
  PREPARING
  DELIVERED
  CANCELLED
}
